 class TestAutoMapping:
+    @pytest.mark.parametrize(
+        ("module_name", "megatron_param", "parallel_mode", "expected"),
+        [
+            ("MindSpeedTELayerNormColumnParallelLinear", "linear.weight", None, "column"),
+            ("MindSpeedTELayerNormColumnParallelLinear", "linear.layer_norm_weight", None, "replicated"),
+            ("MindSpeedTEColumnParallelGroupedLinear", "linear.weight", None, "column"),
+            ("MindSpeedTERowParallelGroupedLinear", "linear.weight", None, "row"),
+            ("MindSpeedTEDotProductAttention", "attention.weight", None, "column"),
+            ("MindSpeedTELinear", "linear.weight", "column", "column"),
+            ("MindSpeedTELinear", "linear.weight", "row", "row"),
+            ("MindSpeedTELinear", "linear.weight", "none", "replicated"),
+            ("InferenceLayerNormColumnParallelLinear", "linear.weight", None, "column"),
+            ("InferenceRowParallelLinear", "linear.weight", None, "row"),
+        ],
+    )
+    def test_detect_mindspeed_and_inference_module_types(
+        self, module_name, megatron_param, parallel_mode, expected
+    ):
+        attributes = {} if parallel_mode is None else {"parallel_mode": parallel_mode}
+        module_type = type(module_name, (torch.nn.Module,), attributes)
+        mapping = AutoMapping(megatron_param=megatron_param, hf_param="hf.weight")
+
+        assert mapping._detect_parallelism_type(module_type()) == expected
+
