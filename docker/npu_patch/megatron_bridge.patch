+import importlib
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tomllib
+from types import ModuleType
+
+from packaging.specifiers import SpecifierSet
+from packaging.version import Version
+import torch
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MCORE_SOURCE = Path(os.environ["MCORE_SOURCE"]).resolve()
+COMPAT_PATH = ROOT / "src" / "megatron" / "bridge" / "models" / "conversion" / "_mcore_compat.py"
+
+
+def _load_compat_module():
+    spec = importlib.util.spec_from_file_location("option_b_mcore_compat", COMPAT_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def _load_param_mapping_module():
+    import megatron
+
+    bridge_root = ROOT / "src" / "megatron" / "bridge"
+    packages = (
+        ("megatron.bridge", bridge_root),
+        ("megatron.bridge.models", bridge_root / "models"),
+        ("megatron.bridge.models.conversion", bridge_root / "models" / "conversion"),
+    )
+    for name, path in packages:
+        package = ModuleType(name)
+        package.__package__ = name
+        package.__path__ = [str(path)]
+        sys.modules[name] = package
+    megatron.bridge = sys.modules["megatron.bridge"]
+    return importlib.import_module("megatron.bridge.models.conversion.param_mapping")
+
+
+def _standard_te_module(name, **attributes):
+    from megatron.core.extensions import transformer_engine as te_extensions
+
+    standard_class = getattr(te_extensions, name, None)
+    instance = None
+    if isinstance(standard_class, type) and issubclass(standard_class, torch.nn.Module):
+        try:
+            instance = object.__new__(standard_class)
+            torch.nn.Module.__init__(instance)
+        except (TypeError, RuntimeError):
+            instance = None
+    if instance is None:
+        faithful_class = type(name, (torch.nn.Module,), {})
+        instance = faithful_class()
+    for attribute, value in attributes.items():
+        setattr(instance, attribute, value)
+    assert type(instance).__name__ == name
+    return instance
+
+
+def test_auto_mapping_classifies_standard_mcore_te_semantics():
+    param_mapping = _load_param_mapping_module()
+    cases = (
+        ("TEColumnParallelLinear", "weight", {}, "column"),
+        ("TERowParallelLinear", "weight", {}, "row"),
+        ("TENorm", "weight", {}, "replicated"),
+        ("TELayerNormColumnParallelLinear", "weight", {}, "column"),
+        ("TELayerNormColumnParallelLinear", "layer_norm_weight", {}, "replicated"),
+        ("TELinear", "weight", {"parallel_mode": "column"}, "column"),
+        ("TELinear", "weight", {"parallel_mode": "row"}, "row"),
+        ("TELinear", "weight", {"parallel_mode": "duplicated"}, "replicated"),
+    )
+
+    for class_name, parameter, attributes, expected in cases:
+        mapping = param_mapping.AutoMapping(f"decoder.{parameter}", "model.weight")
+        module = _standard_te_module(class_name, **attributes)
+        assert mapping._detect_parallelism_type(module) == expected
+
+
+class FakeShard:
+    pass
+
+
+class FakeStridedShard:
+    pass
+
+
+class FakeReplicate:
+    pass
+
+
+class FakeProcessGroup:
+    def __init__(self, size, rank=0):
+        self._size = size
+        self._rank = rank
+
+    def size(self):
+        return self._size
+
+    def rank(self):
+        return self._rank
+
+
+class FakeMesh:
+    mesh_dim_names = ()
+
+    def __init__(self, process_group):
+        self._process_group = process_group
+
+    def get_group(self):
+        return self._process_group
+
+
+class Chunk:
+    def __init__(self, offsets):
+        self.offsets = list(offsets)
+
+
+class LocalMetadata:
+    __create_chunk_list__ = True
+
+
+class FakeDTensor:
+    def __init__(self, local, *, shape, placements, device_mesh, offsets):
+        self._local = local
+        self._local_tensor = LocalMetadata()
+        self._offsets = list(offsets)
+        self.shape = tuple(shape)
+        self.placements = placements
+        self.device_mesh = device_mesh
+
+    def __create_chunk_list__(self):
+        return [Chunk(self._offsets)]
+
+    def to_local(self):
+        return self._local
+
+    @classmethod
+    def from_local(cls, local, *, placements, device_mesh):
+        return cls(
+            local,
+            shape=tuple(local.shape),
+            placements=placements,
+            device_mesh=device_mesh,
+            offsets=[0] * local.ndim,
+        )
+
+
+def _patch_uneven_dtensor_types(monkeypatch, uneven_dtensor):
+    monkeypatch.setattr(uneven_dtensor, "DTensor", FakeDTensor)
+    monkeypatch.setattr(uneven_dtensor, "Shard", FakeShard)
+    monkeypatch.setattr(uneven_dtensor, "_StridedShard", FakeStridedShard)
+    monkeypatch.setattr(uneven_dtensor, "Replicate", FakeReplicate)
+
+
+def test_uneven_dtensor_adapter_preserves_multidimensional_layout_dtype_and_device(monkeypatch):
+    from megatron.core.distributed.fsdp.src.megatron_fsdp import uneven_dtensor
+
+    _patch_uneven_dtensor_types(monkeypatch, uneven_dtensor)
+    expected = torch.arange(15, dtype=torch.float64).reshape(3, 5)
+    chunks = (
+        ({"shape": [2, 3], "offset": [0, 0], "rank": 0}, expected[:2, :3]),
+        ({"shape": [2, 2], "offset": [0, 3], "rank": 1}, expected[:2, 3:]),
+        ({"shape": [1, 3], "offset": [2, 0], "rank": 2}, expected[2:, :3]),
+        ({"shape": [1, 2], "offset": [2, 3], "rank": 3}, expected[2:, 3:]),
+    )
+
+    def fake_all_gather_object(output, local_info, group):
+        output[:] = [metadata for metadata, _ in chunks]
+
+    def fake_all_gather(output, local, group):
+        for destination, (_, chunk) in zip(output, chunks):
+            destination.copy_(chunk)
+
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather_object", fake_all_gather_object)
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather", fake_all_gather)
+    source = FakeDTensor(
+        chunks[0][1],
+        shape=expected.shape,
+        placements=[FakeShard()],
+        device_mesh=FakeMesh(FakeProcessGroup(size=len(chunks))),
+        offsets=chunks[0][0]["offset"],
+    )
+
+    result = _load_compat_module().uneven_dtensor_to_full_tensor(source)
+
+    assert isinstance(result, torch.Tensor)
+    assert torch.equal(result, expected)
+    assert result.dtype == expected.dtype
+    assert result.device == expected.device
+    assert result.layout == torch.strided
+    assert result.stride() == expected.stride()
+
+
+def test_uneven_dtensor_adapter_clones_replicated_tensor_without_shard_gather(monkeypatch):
+    from megatron.core.distributed.fsdp.src.megatron_fsdp import uneven_dtensor
+
+    _patch_uneven_dtensor_types(monkeypatch, uneven_dtensor)
+    local = torch.arange(12, dtype=torch.int64).reshape(3, 4)
+
+    def fake_all_gather_object(output, local_info, group):
+        output[:] = [local_info]
+
+    def unexpected_all_gather(output, tensor, group):
+        raise AssertionError("replicated DTensor must not gather tensor shards")
+
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather_object", fake_all_gather_object)
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather", unexpected_all_gather)
+    source = FakeDTensor(
+        local,
+        shape=local.shape,
+        placements=[FakeReplicate()],
+        device_mesh=FakeMesh(FakeProcessGroup(size=1)),
+        offsets=[0, 0],
+    )
+
+    result = _load_compat_module().uneven_dtensor_to_full_tensor(source)
+
+    assert torch.equal(result, local)
+    assert result.data_ptr() != local.data_ptr()
+    assert result.dtype == local.dtype
+    assert result.device == local.device
+    assert result.layout == local.layout
+
+
+def test_option_b_python_contract_is_metadata_intersection():
+    mcore_metadata = tomllib.loads((MCORE_SOURCE / "pyproject.toml").read_text(encoding="utf-8"))
+    bridge_metadata = tomllib.loads((ROOT / "pyproject.toml").read_text(encoding="utf-8"))
+    mcore_python = SpecifierSet(mcore_metadata["project"]["requires-python"])
+    bridge_python = SpecifierSet(bridge_metadata["project"]["requires-python"])
+
+    assert Version("3.11") not in mcore_python
+    assert Version("3.12") in mcore_python
+    assert Version("3.12") in bridge_python
+    assert Version("3.13") not in bridge_python
+
+
+def test_normal_megatron_bridge_imports_in_clean_process():
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join((str(ROOT / "src"), str(MCORE_SOURCE)))
+    te_npu_source = Path(env["TE_NPU_SOURCE"]).resolve()
+    probe_source = f"""
+import triton
+
+# Import-only smoke tests have no active Triton device driver. The target NPU
+# environment supplies one; bypass autotune construction without bypassing any
+# megatron.bridge package initializers.
+triton.autotune = lambda *args, **kwargs: (lambda fn: fn)
+
+from importlib.metadata import version
+from pathlib import Path
+
+from packaging.specifiers import SpecifierSet
+from packaging.version import Version
+
+import megatron.bridge
+from megatron.bridge import AutoBridge
+from megatron.bridge.training.config import DistributedDataParallelConfig
+from megatron.bridge.training.train import train
+import transformer_engine
+
+assert version("nvidia-modelopt") == "0.43.0"
+assert version("omegaconf") == "2.3.0"
+assert version("tensorboard") == "2.19.0"
+assert Version(version("datasets")) in SpecifierSet(">=2.20,<5")
+assert Path(transformer_engine.__file__).resolve().is_relative_to(Path({str(te_npu_source)!r}))
+"""
+    probe = subprocess.run(
+        [sys.executable, "-c", probe_source],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+    assert probe.returncode == 0, f"stdout:\n{probe.stdout}\nstderr:\n{probe.stderr}"
