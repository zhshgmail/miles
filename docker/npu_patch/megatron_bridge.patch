+import ast
+import importlib.util
+import os
+from pathlib import Path
+import sys
+
+import torch
+
+
+ROOT = Path(__file__).resolve().parents[3]
+COMPAT_PATH = ROOT / "src" / "megatron" / "bridge" / "models" / "conversion" / "_mcore_compat.py"
+PARAM_MAPPING_PATH = ROOT / "src" / "megatron" / "bridge" / "models" / "conversion" / "param_mapping.py"
+
+
+def _load_compat_module():
+    spec = importlib.util.spec_from_file_location("option_b_mcore_compat", COMPAT_PATH)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_standard_te_mapping_contract_has_no_mindspeed_aliases():
+    source = PARAM_MAPPING_PATH.read_text(encoding="utf-8")
+    tree = ast.parse(source)
+    auto_mapping = next(node for node in tree.body if isinstance(node, ast.ClassDef) and node.name == "AutoMapping")
+    class_source = ast.get_source_segment(source, auto_mapping)
+
+    for name in (
+        "TENorm",
+        "TELinear",
+        "TELayerNormColumnParallelLinear",
+        "TEColumnParallelLinear",
+        "TERowParallelLinear",
+        "TEDotProductAttention",
+    ):
+        assert name in class_source
+    assert "MindSpeed" not in class_source
+
+
+def test_uneven_dtensor_adapter_matches_mcore_017_gather_layout(monkeypatch):
+    mcore_source = Path(os.environ["MCORE_SOURCE"]).resolve()
+    sys.path.insert(0, str(mcore_source))
+    try:
+        from megatron.core.distributed.fsdp.src.megatron_fsdp import uneven_dtensor
+    finally:
+        sys.path.pop(0)
+
+    class FakeShard:
+        pass
+
+    class FakeStridedShard:
+        pass
+
+    class FakeReplicate:
+        pass
+
+    class FakeProcessGroup:
+        @staticmethod
+        def size():
+            return 2
+
+        @staticmethod
+        def rank():
+            return 0
+
+    class FakeMesh:
+        mesh_dim_names = ()
+
+        def get_group(self):
+            return FakeProcessGroup()
+
+    class Chunk:
+        offsets = [0]
+
+    class LocalMetadata:
+        __create_chunk_list__ = True
+
+    class FakeDTensor:
+        def __init__(self, local, *, shape, placements, device_mesh):
+            self._local = local
+            self._local_tensor = LocalMetadata()
+            self.shape = shape
+            self.placements = placements
+            self.device_mesh = device_mesh
+
+        def __create_chunk_list__(self):
+            return [Chunk()]
+
+        def to_local(self):
+            return self._local
+
+        @classmethod
+        def from_local(cls, local, *, placements, device_mesh):
+            return cls(local, shape=tuple(local.shape), placements=placements, device_mesh=device_mesh)
+
+    def fake_all_gather_object(output, local_info, group):
+        output[:] = [
+            local_info,
+            {"shape": [1], "offset": [2], "rank": 1},
+        ]
+
+    def fake_all_gather(output, local, group):
+        output[0].copy_(local)
+        output[1].copy_(torch.tensor([3.0]))
+
+    monkeypatch.setattr(uneven_dtensor, "DTensor", FakeDTensor)
+    monkeypatch.setattr(uneven_dtensor, "Shard", FakeShard)
+    monkeypatch.setattr(uneven_dtensor, "_StridedShard", FakeStridedShard)
+    monkeypatch.setattr(uneven_dtensor, "Replicate", FakeReplicate)
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather_object", fake_all_gather_object)
+    monkeypatch.setattr(uneven_dtensor.dist, "all_gather", fake_all_gather)
+
+    source = FakeDTensor(
+        torch.tensor([1.0, 2.0]),
+        shape=(3,),
+        placements=[FakeShard()],
+        device_mesh=FakeMesh(),
+    )
+    adapter = _load_compat_module()
+
+    result = adapter.uneven_dtensor_to_full_tensor(source)
+
+    assert isinstance(result, torch.Tensor)
+    assert torch.equal(result, torch.tensor([1.0, 2.0, 3.0]))
