+"""Compatibility helpers for the pinned Megatron Core runtime."""
+
+
+def uneven_dtensor_to_full_tensor(dtensor):
+    """Return the local full tensor produced by Mcore 0.17's replicated gather."""
+    from megatron.core.distributed.fsdp.src.megatron_fsdp.uneven_dtensor import (
+        gather_uneven_dtensor_to_full_tensor,
+    )
+
+    return gather_uneven_dtensor_to_full_tensor(dtensor).to_local()
