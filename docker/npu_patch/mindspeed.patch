diff --git a/tests_extend/unit_tests/mindspeed/test_miles_compat.py b/tests_extend/unit_tests/mindspeed/test_miles_compat.py
new file mode 100644
index 0000000..dc854e7
--- /dev/null
+++ b/tests_extend/unit_tests/mindspeed/test_miles_compat.py
@@ -0,0 +1,96 @@
+from types import ModuleType, SimpleNamespace
+import sys
+
+from mindspeed.patch_utils import Patch
+
+
+def test_classmethod_patch_removal_restores_inherited_descriptor():
+    module = ModuleType("mindspeed_miles_patch_fixture")
+
+    class Target:
+        pass
+
+    module.Target = Target
+    sys.modules[module.__name__] = module
+    calls = []
+
+    def patched_init_subclass(cls, **kwargs):
+        calls.append(cls.__name__)
+
+    try:
+        patch = Patch(
+            f"{module.__name__}.Target.__init_subclass__",
+            classmethod(patched_init_subclass),
+            False,
+        )
+        patch.apply_patch()
+
+        class PatchedChild(Target):
+            pass
+
+        assert calls == ["PatchedChild"]
+        patch.remove_patch()
+        assert "__init_subclass__" not in Target.__dict__
+
+        class RestoredChild(Target):
+            pass
+
+        assert calls == ["PatchedChild"]
+    finally:
+        sys.modules.pop(module.__name__, None)
+
+
+def test_transformer_config_mutable_defaults_are_isolated(monkeypatch):
+    from mindspeed.core.megatron_basic import arguments_basic
+
+    monkeypatch.setattr(
+        arguments_basic,
+        "get_full_args",
+        lambda: SimpleNamespace(list_option=[1], dict_option={"key": "value"}),
+    )
+
+    class Config:
+        __annotations__ = {}
+
+    arguments_basic.transformer_config_init_subclass(Config)
+    first_list = Config.list_option.default_factory()
+    second_list = Config.list_option.default_factory()
+    first_dict = Config.dict_option.default_factory()
+    second_dict = Config.dict_option.default_factory()
+
+    assert first_list == [1]
+    assert second_list == [1]
+    assert first_dict == {"key": "value"}
+    assert second_dict == {"key": "value"}
+    assert first_list is not second_list
+    assert first_dict is not second_dict
+
+
+def test_fused_rope_forwards_cp_group_for_thd(monkeypatch):
+    from megatron.core.models.common.embeddings import rope_utils
+    from mindspeed.core.fusions import fused_rope
+
+    sentinel_group = object()
+    captured = {}
+
+    def fake_apply(t, cu_seqlens, freqs, **kwargs):
+        captured.update(kwargs)
+        return "forwarded"
+
+    monkeypatch.setattr(rope_utils, "_apply_rotary_pos_emb_thd", fake_apply)
+    config = SimpleNamespace(
+        apply_rope_fusion=False,
+        rotary_interleaved=False,
+        multi_latent_attention=False,
+    )
+
+    result = fused_rope.apply_rotary_pos_emb(
+        object(),
+        object(),
+        config,
+        cu_seqlens=object(),
+        cp_group=sentinel_group,
+    )
+
+    assert result == "forwarded"
+    assert captured["cp_group"] is sentinel_group
