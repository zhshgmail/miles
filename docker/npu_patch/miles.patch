+    if isinstance(node, ast.Import):
+        return tuple(alias.name for alias in node.names)
+    if isinstance(node, ast.ImportFrom):
+        return (node.module or "",)
+    return ()
+
+
+def test_each_megatron_process_entry_imports_adaptor_before_mcore():
+    for path in MEGATRON_ENTRY_PATHS:
+        source = path.read_text(encoding="utf-8")
+        imports = sorted(
+            (node for node in ast.walk(ast.parse(source)) if isinstance(node, (ast.Import, ast.ImportFrom))),
+            key=lambda node: node.lineno,
+        )
+        adaptor = [node for node in imports if "megatron_adaptor" in _imported_modules(node)]
+        mcore = [
+            node
+            for node in imports
+            if any(name == "megatron" or name.startswith("megatron.") for name in _imported_modules(node))
+        ]
+
+        assert len(adaptor) == 1, path
+        assert mcore, path
+        assert adaptor[0].lineno < mcore[0].lineno, path
+        assert "mindspeed" not in source.lower()
+        assert "repatch" not in source
+
+
+def _require_live_npu():
+    try:
+        import torch_npu  # noqa: F401
+
+        available = torch.npu.is_available() and torch.npu.device_count() > 0
+    except (ImportError, RuntimeError):
+        available = False
+    if available:
+        return
+    message = "requires the Option-B Python 3.12 live NPU runtime"
+    if os.environ.get("OPTION_B_REQUIRE_LIVE_NPU") == "1":
+        pytest.fail(message)
+    pytest.skip(message)
+
+
+def test_direct_entries_bind_jit_after_exact_adaptor_patch():
+    mcore_source = Path(os.environ["MCORE_SOURCE"]).resolve()
+    adaptor_source = Path(os.environ["MEGATRON_ADAPTOR_SOURCE"]).resolve()
+    adaptor_commit = subprocess.check_output(
+        ["git", "-C", str(adaptor_source), "rev-parse", "HEAD"], text=True
+    ).strip()
+    assert adaptor_commit == "56e18624ec632cf462c079c3873b8fbf2fbd3c77"
+    assert sys.version_info[:2] == (3, 12)
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join((str(ROOT), str(adaptor_source), str(mcore_source)))
+    probe_source = f"""
+import ast
+from pathlib import Path
+import sys
+
+path = Path(sys.argv[1])
+tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
+imports = [node for node in tree.body if isinstance(node, (ast.Import, ast.ImportFrom))]
+
+def names(node):
+    if isinstance(node, ast.Import):
+        return tuple(alias.name for alias in node.names)
+    return (node.module or "",)
+
+adaptor = next(node for node in imports if "megatron_adaptor" in names(node))
+mcore = next(
+    node
+    for node in imports
+    if any(name == "megatron" or name.startswith("megatron.") for name in names(node))
+)
+exec(compile(ast.Module(body=[adaptor, mcore], type_ignores=[]), str(path), "exec"), {{}})
+import megatron_adaptor
+import torch
+from megatron.core.jit import jit_fuser
+assert Path(megatron_adaptor.__file__).resolve().is_relative_to(Path({str(adaptor_source)!r}))
+assert jit_fuser is torch.compile
+assert jit_fuser is torch.jit.script
+assert jit_fuser.__module__ == "megatron_adaptor.patches.requirements.requirements"
+assert jit_fuser.__name__ == "dummy_compile"
+"""
+
+    for path in DIRECT_MEGATRON_ENTRYPOINTS:
+        probe = subprocess.run(
+            [sys.executable, "-c", probe_source, str(path)],
+            env=env,
+            capture_output=True,
+            text=True,
+            timeout=30,
+        )
+        assert probe.returncode == 0, f"{path}\nstdout:\n{probe.stdout}\nstderr:\n{probe.stderr}"
+
+
+def test_ppo_compile_decorators_remain_active():
+    path = ROOT / "miles" / "utils" / "ppo_utils.py"
+    source = path.read_text(encoding="utf-8")
+    tree = ast.parse(source)
+    decorators = [
+        decorator
+        for node in ast.walk(tree)
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef))
+        for decorator in node.decorator_list
+        if isinstance(decorator, ast.Call)
+        and isinstance(decorator.func, ast.Attribute)
+        and isinstance(decorator.func.value, ast.Name)
+        and decorator.func.value.id == "torch"
+        and decorator.func.attr == "compile"
+    ]
+
+    assert len(decorators) == 3
+    assert "# @torch.compile" not in source
+
+
+def test_convert_hf_to_torch_dist_imports_with_pinned_mbridge():
+    _require_live_npu()
+    mcore_source = Path(os.environ["MCORE_SOURCE"]).resolve()
+    bridge_source = Path(os.environ["BRIDGE_SOURCE"]).resolve()
+    mbridge_source = Path(os.environ["MBRIDGE_SOURCE"]).resolve()
+    te_npu_source = Path(os.environ["TE_NPU_SOURCE"]).resolve()
+    adaptor_source = Path(os.environ["MEGATRON_ADAPTOR_SOURCE"]).resolve()
+    mbridge_commit = subprocess.check_output(
+        ["git", "-C", str(mbridge_source), "rev-parse", "HEAD"], text=True
+    ).strip()
+    assert mbridge_commit == "89eb10887887bc74853f89a4de258c0702932a1c"
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join(
+        (
+            str(ROOT),
+            str(adaptor_source),
+            str(te_npu_source),
+            str(bridge_source / "src"),
+            str(mcore_source),
+        )
+    )
+    probe_source = f"""
+from importlib.metadata import version
+from pathlib import Path
+
+import torch
+import torch_npu
+import tools.convert_hf_to_torch_dist
+import mbridge
+import transformer_engine
+
+assert torch.npu.is_available() and torch.npu.device_count() > 0
+assert version("mbridge") == "0.15.1"
+assert version("triton-ascend") == "3.2.1"
+assert Path(mbridge.__file__).resolve().is_relative_to(Path({str(mbridge_source)!r}))
+assert Path(transformer_engine.__file__).resolve().is_relative_to(Path({str(te_npu_source)!r}))
+"""
+    probe = subprocess.run(
+        [sys.executable, "-c", probe_source],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+    assert probe.returncode == 0, f"stdout:\n{probe.stdout}\nstderr:\n{probe.stderr}"
