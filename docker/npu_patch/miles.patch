+    ray.remote = lambda **kwargs: lambda fn: fn
+    ray_util = ModuleType("ray.util")
+    ray_scheduling = ModuleType("ray.util.scheduling_strategies")
+    ray_scheduling.NodeAffinitySchedulingStrategy = object
+    sys.modules["ray"] = ray
+    sys.modules["ray.util"] = ray_util
+    sys.modules["ray.util.scheduling_strategies"] = ray_scheduling
+
+from miles.utils.external_utils import command_utils
+
+
+def test_execute_train_npu_forwards_runtime_prefixes_and_megatron_path(monkeypatch):
+    commands = []
+    bool_env_names = []
+
+    def get_bool_env_var(name, default="false"):
+        bool_env_names.append(name)
+        return name == "MILES_SCRIPT_ENABLE_RAY_SUBMIT"
+
+    monkeypatch.setattr(
+        command_utils,
+        "get_bool_env_var",
+        get_bool_env_var,
+    )
+    monkeypatch.setattr(
+        command_utils,
+        "exec_command",
+        lambda command, *args, **kwargs: commands.append(command) or "",
+    )
+    monkeypatch.setattr(command_utils, "check_has_nvlink", lambda: False)
+    monkeypatch.setenv("ASCEND_CUSTOM_OPP_PATH", "/opt/ascend/custom")
+    monkeypatch.setenv("ATB_CUSTOM_PATH", "/opt/atb/custom")
+    monkeypatch.setenv("PYTHONPATH", "/opt/existing/python")
+
+    command_utils.execute_train_npu(
+        train_args="--mock-training",
+        num_gpus_per_node=1,
+        megatron_model_type="mock_model",
+        megatron_path="/workspace/Megatron-LM",
+    )
+
+    submit = commands[-1]
+    match = re.search(r"--runtime-env-json='([^']+)'", submit)
+    assert match is not None
+    env = json.loads(match.group(1))["env_vars"]
+    assert env["ASCEND_CUSTOM_OPP_PATH"] == "/opt/ascend/custom"
+    assert env["ATB_CUSTOM_PATH"] == "/opt/atb/custom"
+    assert env["PYTHONPATH"] == "/workspace/Megatron-LM:/opt/existing/python"
+    assert bool_env_names == [
+        "MILES_SCRIPT_EXTERNAL_RAY",
+        "MILES_SCRIPT_ENABLE_RAY_SUBMIT",
+    ]
