diff --git a/tests/test_npu_patch_megatron_adaptor.py b/tests/test_npu_patch_megatron_adaptor.py
new file mode 100644
index 000000000..2a3baf58b
--- /dev/null
+++ b/tests/test_npu_patch_megatron_adaptor.py
@@ -0,0 +1,58 @@
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[1]
+BOOTSTRAP = ROOT / "miles" / "backends" / "megatron_utils" / "__init__.py"
+MEGATRON_ENTRYPOINTS = (
+    BOOTSTRAP,
+    ROOT / "miles" / "backends" / "megatron_utils" / "actor.py",
+    ROOT / "miles" / "backends" / "megatron_utils" / "initialize.py",
+    ROOT / "tools" / "convert_hf_to_torch_dist.py",
+    ROOT / "train.py",
+)
+
+
+def test_megatron_adaptor_has_one_early_bootstrap_and_no_mindspeed_api():
+    sources = {path: path.read_text(encoding="utf-8") for path in MEGATRON_ENTRYPOINTS}
+
+    assert sources[BOOTSTRAP].count("import megatron_adaptor") == 1
+    assert sum(text.count("import megatron_adaptor") for text in sources.values()) == 1
+    assert all("mindspeed" not in text.lower() for text in sources.values())
+    assert all("repatch" not in text for text in sources.values())
+
+    bootstrap = sources[BOOTSTRAP]
+    assert bootstrap.index("import megatron_adaptor") < bootstrap.index("from megatron.bridge")
+
+
+def test_bootstrap_patches_jit_before_mcore_binds_jit_fuser(tmp_path):
+    mcore_source = Path(os.environ["MCORE_SOURCE"]).resolve()
+    (tmp_path / "megatron_adaptor.py").write_text(
+        "import torch\n"
+        "def dummy_compile(fn):\n"
+        "    def wrapper(*args, **kwargs):\n"
+        "        return fn(*args, **kwargs)\n"
+        "    return wrapper\n"
+        "torch.jit.script = dummy_compile\n"
+        "torch.compile = dummy_compile\n",
+        encoding="utf-8",
+    )
+    env = os.environ.copy()
+    env["PYTHONPATH"] = os.pathsep.join((str(tmp_path), str(ROOT), str(mcore_source)))
+    probe = subprocess.run(
+        [
+            sys.executable,
+            "-c",
+            "import miles.backends.megatron_utils; "
+            "from megatron.core.jit import jit_fuser; "
+            "assert jit_fuser.__module__ == 'megatron_adaptor'",
+        ],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+
+    assert probe.returncode == 0, probe.stderr
