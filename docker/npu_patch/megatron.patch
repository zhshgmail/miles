@@ -0,0 +1,59 @@
+import importlib
+from types import SimpleNamespace
+
+import torch
+
+from megatron.core.pipeline_parallel import utils as pipeline_utils
+from megatron.core.transformer import module as transformer_module
+
+
+class NpuFloatTensor:
+    def half(self):
+        return NpuHalfTensor()
+
+
+class NpuHalfTensor:
+    def float(self):
+        return NpuFloatTensor()
+
+
+class NpuBFloat16Tensor:
+    def float(self):
+        return NpuFloatTensor()
+
+
+class IdentityModule(torch.nn.Module):
+    def forward(self, value):
+        return value
+
+
+def test_float16_module_converts_registered_npu_tensor_types(monkeypatch):
+    monkeypatch.setattr(
+        torch,
+        "npu",
+        SimpleNamespace(
+            FloatTensor=NpuFloatTensor,
+            HalfTensor=NpuHalfTensor,
+            BFloat16Tensor=NpuBFloat16Tensor,
+        ),
+        raising=False,
+    )
+    module = importlib.reload(transformer_module)
+
+    assert NpuFloatTensor in module._FLOAT_TYPES
+    assert NpuHalfTensor in module._HALF_TYPES
+    assert NpuBFloat16Tensor in module._BF16_TYPES
+
+    config = SimpleNamespace(
+        fp16=True,
+        bf16=False,
+        virtual_pipeline_model_parallel_size=None,
+    )
+    wrapped = module.Float16Module(config=config, module=IdentityModule())
+    monkeypatch.setattr(module.parallel_state, "get_pipeline_model_parallel_group", lambda: None)
+    monkeypatch.setattr(pipeline_utils, "is_pp_first_stage", lambda group: True)
+    monkeypatch.setattr(pipeline_utils, "is_vp_first_stage", lambda stage, size: True)
+
+    result = wrapped(NpuFloatTensor(), fp32_output=False)
+
+    assert isinstance(result, NpuHalfTensor)
